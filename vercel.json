{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "functions": {
    "api/index.py": {
      "includeFiles": "{server/**,index.html,history.html,rsvp.html,host.html,style.css,logo.svg,event.ics,assets/**,data/course.json,photos/public/**}",
      "maxDuration": 30
    }
  },
  "routes": [{"src": "/(.*)", "dest": "/api/index.py?_route=$1"}]
}
